# ============================================
# .gitignore - Files to exclude from Git
# ============================================

# API Keys and Secrets
.env
config.py
*.key
*.pem
secrets/
ENV_MIGRATION_SUMMARY.md

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environment
venv/
env/
ENV/
env.bak/
venv.bak/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Streamlit
.streamlit/secrets.toml

# Logs
*.log
logs/

# Database
*.db
*.sqlite
*.sqlite3

# Generated Files
generated_services/
*.zip

# OS Files
Thumbs.db
.DS_Store

# Test Files
test_*.py
*_test.py
